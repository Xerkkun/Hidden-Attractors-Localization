eqfun[x_]=(a1+(b/(b+c)/.pa))x+a2 ArcTan[rho x];
xa=x/.FindRoot[eqfun[x]==0,{x,SetPrecision[4.65,50]},WorkingPrecision->45,AccuracyGoal->30,PrecisionGoal->30];
slope[x_]=a1+a2 rho/(1+rho^2 x^2);
